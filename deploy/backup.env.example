# Backup sidecar settings: copy to deploy/backup.env (git-ignored, chmod 600).
# rclone reads remotes from RCLONE_CONFIG_<NAME>_<OPTION> variables, so no
# rclone.conf is needed. Two remotes: "offsite" (where the files land) and
# "offsitecrypt" (client-side encryption on top of it). Backups hold emails
# and password hashes: always upload through the crypt remote.
#
# Fill in ONE "offsite" block: A (Hetzner Storage Box over SFTP, this
# deployment) or B (S3-compatible object storage). Pick storage in the same
# jurisdiction as the VM (EU for DACH users) and name it on the privacy page.
# Setup and the trade-offs: docs/RUNBOOK.md section 5.

# --- A: Hetzner Storage Box (SFTP) -----------------------------------------
# A sub-account limited to one directory (Hetzner console: Storage Box ->
# Sub-accounts; SSH support on, external reachability on). The sub-account's
# directory is its root, so "companion-backups" below is a folder inside it.
RCLONE_CONFIG_OFFSITE_TYPE=sftp
RCLONE_CONFIG_OFFSITE_HOST=u123456-sub1.your-storagebox.de
RCLONE_CONFIG_OFFSITE_PORT=23
RCLONE_CONFIG_OFFSITE_USER=u123456-sub1
# Either the sub-account's password, OBSCURED (rclone obscure 'the-password')...
RCLONE_CONFIG_OFFSITE_PASS=
# ...or an SSH key instead of the password: put the private key (no
# passphrase, PEM or OpenSSH format) in deploy/backup-ssh/id_ed25519, mount
# that directory read-only (see the commented volume in compose.yaml), upload
# the public key to the sub-account, leave PASS empty and set:
# RCLONE_CONFIG_OFFSITE_KEY_FILE=/config/ssh/id_ed25519
# Pin the box's host key (recommended; without it rclone accepts any key):
#   ssh-keyscan -p 23 u123456-sub1.your-storagebox.de > deploy/backup-ssh/known_hosts
# then compare the fingerprints with the ones Hetzner publishes, and set:
# RCLONE_CONFIG_OFFSITE_KNOWN_HOSTS_FILE=/config/ssh/known_hosts
# The crypt remote never asks for remote hashes (backup.sh downloads the
# archive again and compares its own sha256), so rclone need not probe the
# box's restricted shell for hash commands.
RCLONE_CONFIG_OFFSITE_DISABLE_HASHCHECK=true
# Storage Boxes limit simultaneous connections per account; a backup is
# three files, so a few parallel transfers are plenty.
RCLONE_TRANSFERS=2
RCLONE_CHECKERS=4

# --- B: S3-compatible object storage (instead of A) ---------------------------
# Any S3-compatible provider works (Hetzner Object Storage, Scaleway, Backblaze
# B2 S3 API, Cloudflare R2, Wasabi, AWS). Comment out block A and use:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://fsn1.your-objectstorage.com
# RCLONE_CONFIG_OFFSITE_REGION=fsn1
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ACL=private
# Some providers reject the newer checksum headers; rclone handles this, keep
# the default unless uploads fail with a checksum error.
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# --- Encryption (both options) ----------------------------------------------------
RCLONE_CONFIG_OFFSITECRYPT_TYPE=crypt
# Storage Box: a folder in the sub-account's directory. S3: <bucket>[/path].
RCLONE_CONFIG_OFFSITECRYPT_REMOTE=offsite:companion-backups
# Both values must be OBSCURED: rclone obscure 'the-passphrase'
# Keep the plain passphrases in the owner's password manager: without them the
# backups cannot be decrypted. They are not stored anywhere else.
RCLONE_CONFIG_OFFSITECRYPT_PASSWORD=
RCLONE_CONFIG_OFFSITECRYPT_PASSWORD2=

# What backup.sh uploads to.
RCLONE_REMOTE=offsitecrypt:
BACKUP_PREFIX=companion
RETENTION_DAYS=30
KEEP_MIN=7
BACKUP_COMPRESS=zstd

# Optional dead-man's switch (healthchecks.io or self-hosted): pinged on
# success, <url>/fail on failure; alerts when no ping arrives for a day.
# External service: the owner decides (MISSION section 7, "ask first").
# Without an external service: scripts/backup-watch.sh from another server
# (docs/RUNBOOK.md section 2.7).
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
