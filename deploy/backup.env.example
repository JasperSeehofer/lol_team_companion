# Backup sidecar settings: copy to deploy/backup.env (git-ignored, chmod 600).
# rclone reads remotes from RCLONE_CONFIG_<NAME>_<OPTION> variables, so no
# rclone.conf is needed. Two remotes: "offsite" (the S3 bucket) and
# "offsitecrypt" (client-side encryption on top of it). Backups hold emails
# and password hashes: always upload through the crypt remote.
#
# Any S3-compatible provider works (Hetzner Object Storage, Scaleway, Backblaze
# B2 S3 API, Cloudflare R2, Wasabi, AWS). Pick one in the same jurisdiction as
# the VM (EU for DACH users) and list it in the privacy page as a processor.

RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://fsn1.your-objectstorage.com
RCLONE_CONFIG_OFFSITE_REGION=fsn1
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ACL=private
# Some providers reject the newer checksum headers; rclone handles this, keep
# the default unless uploads fail with a checksum error.
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

RCLONE_CONFIG_OFFSITECRYPT_TYPE=crypt
RCLONE_CONFIG_OFFSITECRYPT_REMOTE=offsite:companion-backups
# Both values must be OBSCURED: rclone obscure 'the-passphrase'
# Keep the plain passphrases in the owner's password manager: without them the
# backups cannot be decrypted. They are not stored anywhere else.
RCLONE_CONFIG_OFFSITECRYPT_PASSWORD=
RCLONE_CONFIG_OFFSITECRYPT_PASSWORD2=

# What backup.sh uploads to.
RCLONE_REMOTE=offsitecrypt:
BACKUP_PREFIX=companion
RETENTION_DAYS=30
KEEP_MIN=7
BACKUP_COMPRESS=zstd

# Optional dead-man's switch (healthchecks.io or self-hosted): pinged on
# success, <url>/fail on failure; alerts when no ping arrives for a day.
# External service: the owner decides (MISSION section 7, "ask first").
# HEALTHCHECK_PING_URL=https://hc-ping.com/<uuid>
