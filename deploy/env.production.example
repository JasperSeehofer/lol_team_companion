# Team Companion production settings. On the VM: cp deploy/env.production.example .env
# then chmod 600 .env. compose.yaml reads this file twice: for ${...}
# substitution in compose.yaml itself, and as the app's environment.
# Keep values free of "$" (compose interpolates them). Never commit .env.

# --- Compose / Caddy ---------------------------------------------------------
# Public host name; DNS A/AAAA records must point at the VM before first start.
COMPANION_DOMAIN=app.team-companion.eu
# Contact for Let's Encrypt expiry notices.
ACME_EMAIL=info@team-companion.eu
# Image tag to run (git short sha); set by the update procedure.
COMPANION_TAG=latest
# Nightly backup time, UTC (HH:MM).
BACKUP_AT=02:30

# --- Required -------------------------------------------------------------------
# HMAC key for the session auth hash. At least 32 bytes; generate with
#   openssl rand -hex 32
# Changing it signs everyone out (RUNBOOK "Rotate SESSION_SECRET").
SESSION_SECRET=

# --- Admin and invites -----------------------------------------------------------
# Register the admin account FIRST (with the bootstrap invite below), then add
# its email here and restart. There is no email verification: listing an
# address before its owner registered it lets anyone who registers it first
# become admin.
ADMIN_EMAILS=
# Bootstrap invite for the very first registration. Remove it (and restart)
# once the admin exists; mint further codes on /admin/invites.
BOOTSTRAP_INVITE_CODE=
BOOTSTRAP_INVITE_MAX_USES=1

# --- Riot API ----------------------------------------------------------------------
# Production key from the Riot developer portal (owner holds it).
RIOT_API_KEY=
# Process-wide request budget. The defaults (20/s, 50/min) fit a development
# key. For a production key use the limits the portal shows for the approved
# app. Typical production limits are 500 per 10 s and 30,000 per 10 min (per
# region; the app budget is global, so it stays on the safe side). The per-min
# window allows a 2-minute burst (2 x PER_MIN), so 45/s and 2400/min stay under
# both limits even in the worst case (45 x 10 = 450 < 500;
# 4800 + 10 x 2400 = 28,800 < 30,000). riven also obeys Riot's rate-limit
# headers on top of this.
# RIOT_GLOBAL_BUDGET_PER_SEC=45
# RIOT_GLOBAL_BUDGET_PER_MIN=2400

# --- Fixed by compose.yaml (listed for reference; values here are ignored) -----
# SURREAL_DATA_DIR=/data/db
# BUG_REPORT_INBOX_PATH=/data/inbox/bug-reports.md
# TRUST_FORWARDED_FOR=true
# LEPTOS_ENV=PROD, LEPTOS_SITE_ADDR=0.0.0.0:3020, APP_ENV unset

# --- Defaults that are right for production (do not set) ------------------------
# SHUTDOWN_DRAIN_SECS / SHUTDOWN_DB_SECS  10 / 15 (compose sets 15): the stop fits the 30 s grace period
# A malformed value of any setting stops the server; docker compose logs app
# lists every problem.
# COOKIE_SECURE      true outside dev
# CLOSED_BETA        ignored outside dev: the invite gate is always on
# RATE_LIMIT_MULTIPLIER must stay 1 in production (e2e uses 100)
# RUST_LOG           info (image default); use info,lol_team_companion=debug briefly to debug
# MATCH_CACHE_RETENTION_DAYS 365: cached Riot games are deleted 12 months after they were
#                    fetched (the privacy page says so; change both together)

# SurrealKV block cache (bytes): compose.yaml sets 256 MiB (SurrealDB's own
# default would be its 16 MiB minimum under the 1.5 GB container limit).
# Raise it together with the memory limit in compose.yaml if needed.
