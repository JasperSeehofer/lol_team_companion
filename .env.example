RIOT_API_KEY=RGAPI-your-key-here
# Process-wide Riot request budget (defaults fit a development key: 20 per
# second, 100 per two minutes). Raise both for a production key.
# RIOT_GLOBAL_BUDGET_PER_SEC=20
# RIOT_GLOBAL_BUDGET_PER_MIN=50
# SURREAL_DATA_DIR=./data   # optional, defaults to ./data
GITHUB_TOKEN=ghp_your-github-pat-here   # for GitHub MCP server

# --- Security (M1); see CLAUDE.md "Configuration" ---------------------------
# Development run. `cargo leptos watch` already sets LEPTOS_ENV=DEV, which
# counts, so this is only needed when running the binary directly in dev.
# Leave it commented in any deployed .env: dev mode drops the SESSION_SECRET
# requirement, turns off the Secure cookie and honours CLOSED_BETA=false.
# APP_ENV=dev
# Session auth-hash key, at least 32 bytes. Required outside dev; in dev a
# random key is used per run (sessions end when the server restarts).
# SESSION_SECRET=
# Invite gate: on by default; `false` turns it off, honoured only in dev.
# CLOSED_BETA=false
# Secure flag on the session cookie (default: true outside dev, false in dev).
# COOKIE_SECURE=true
# Comma-separated admin emails. Listed addresses are promoted when they sign
# in; removing an address revokes admin (at once for access checks, and the
# stored flag is cleared at that user's next sign-in). No email verification
# exists: list an address only after its owner has registered it.
# ADMIN_EMAILS=you@example.com
# Ensure this invite code exists at startup (handy for the first admin and
# for e2e runs), with this many uses (default 1).
# BOOTSTRAP_INVITE_CODE=
# BOOTSTRAP_INVITE_MAX_USES=1
# Scale all rate limits (e2e runs register many users from one IP).
# RATE_LIMIT_MULTIPLIER=1
# Behind a reverse proxy: take the client IP from the last X-Forwarded-For hop.
# TRUST_FORWARDED_FOR=false

# --- Community loop (M7) ------------------------------------------------------
# The one external support page (Ko-fi or GitHub's equivalent), shown only on
# /transparency and only once the owner approved the money texts on
# /admin/texts. Absolute https:// URL without credentials; anything else is
# ignored with a warning. Leave empty until the owner confirms the page.
# SUPPORT_URL=
