/test-results/

# Deployment state next to the checkout (M8): backup credentials, the
# previous image tag, restore drill logs and scratch restores.
deploy/backup.env
deploy/backup-ssh/
.previous-tag
restore-drills.log
restore-*/

# navgrid tool (M166): local venv and build metadata
tools/navgrid/.venv/
tools/navgrid/*.egg-info/
tools/navgrid/**/__pycache__/
# navgrid (M166): nothing derived from a real Riot file is ever committed
# (Riot ticket 2 pending). Grids, WADs, output and GeoJSON stay out of git;
# only the tests' synthetic fixtures may hold GeoJSON.
**/*.aimesh_ngrid
**/*.wad.client
tools/navgrid/out/
*.geojson
!tools/navgrid/tests/fixtures/synthetic/*.geojson
